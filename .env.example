# Copy to .env, fill in, then:  set -a; source .env; set +a; claude
# NEVER commit .env. Everything here is TEST-environment only.

# ── Azure DevOps ───────────────────────────────────────────────────────────
ADO_ORG=your-org                      # https://dev.azure.com/<ADO_ORG>
ADO_PROJECT=your-project
# PAT scopes needed: Code (Read), Build (Read & execute), Work Items (Read & write),
# Test Management (Read & write). The MCP server wants base64("<any-email>:<pat>"):
#   echo -n "qa@movii.com:<PAT>" | base64
ADO_PAT_B64=
# Raw PAT for git clone over https (used only by scripts, never printed)
ADO_PAT=

# ── Kubernetes (OKE – TEST cluster only) ───────────────────────────────────
KUBECONFIG_TEST=/home/<you>/.kube/oke-test.yaml
K8S_CONTEXT_TEST=oke-test

# ── MySQL (TEST, READ-ONLY user) ───────────────────────────────────────────
# Create the user like this (DBA):  GRANT SELECT, SHOW VIEW, PROCESS ON *.* TO 'qa_ro'@'%';
MYSQL_TEST_HOST=mysql-test.internal
MYSQL_TEST_PORT=3306
MYSQL_TEST_RO_USER=qa_ro
MYSQL_TEST_RO_PASS=
MYSQL_TEST_DB=

# ── Oracle Cloud (optional – logs/metrics) ─────────────────────────────────
OCI_TEST_PROFILE=qa-test              # profile in ~/.oci/config scoped to the TEST compartment

# ── Reporting ──────────────────────────────────────────────────────────────
QA_TESTER_NAME=
